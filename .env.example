# WorkOS AI Configuration

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=workos
DB_PASSWORD=workos-dev-password
DB_NAME=workos_ai
DB_SSL_MODE=disable

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7

# Service Ports
ORCHESTRATOR_PORT=50051
EXECUTIVE_AGENT_PORT=50052
HR_AGENT_PORT=50053
SALES_AGENT_PORT=50054
DEV_AGENT_PORT=50055
MARKETING_AGENT_PORT=50056

# Service Hosts
ORCHESTRATOR_HOST=localhost
EXECUTIVE_AGENT_HOST=localhost
HR_AGENT_HOST=localhost
SALES_AGENT_HOST=localhost
DEV_AGENT_HOST=localhost
MARKETING_AGENT_HOST=localhost

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Environment
ENVIRONMENT=development
DEBUG=false

# Knowledge Graph
KNOWLEDGE_GRAPH_BATCH_SIZE=100
KNOWLEDGE_GRAPH_TIMEOUT=30s

# Task Configuration
TASK_TIMEOUT=5m
TASK_MAX_RETRIES=3
TASK_RETRY_DELAY=10s

# Memory Configuration
MEMORY_SHORT_TERM_TTL=1h
MEMORY_LONG_TERM_TTL=365d
MEMORY_MAX_SIZE=10gb

# Event Configuration
EVENT_BATCH_SIZE=50
EVENT_FLUSH_INTERVAL=1s

# Security
JWT_SECRET=your-jwt-secret-here
API_KEY=your-api-key-here

# Kubernetes (if deploying)
NAMESPACE=default
IMAGE_REGISTRY=docker.io
IMAGE_TAG=latest
REPLICA_COUNT=1

# Performance
WORKER_POOL_SIZE=10
QUEUE_SIZE=1000
CACHE_TTL=1h
