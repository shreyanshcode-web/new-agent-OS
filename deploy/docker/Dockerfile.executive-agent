# Executive Agent Dockerfile
FROM golang:1.21-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git protobuf-dev protoc

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 GOOS=linux go build -a -installsuffix cgo -o executive-agent ./cmd/executive-agent

FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

COPY --from=builder /app/executive-agent .
COPY .env.example .env

EXPOSE 50052

CMD ["./executive-agent"]
